# ── Gemini AI (recipe safety analysis, photo moderation, chat, AI email copy) ──
GEMINI_API_KEY="your-gemini-api-key"

# ── App URL (used for email links, unsubscribe links, Stripe redirect URLs) ──
# Set this to your production Vercel URL once deployed, e.g. https://jarcheck.vercel.app
APP_URL="http://localhost:3000"

# ── Supabase (stores newsletter subscribers + sent-email log) ──
# Project Settings -> API in your Supabase dashboard
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Supabase Auth (subscriber login -- these two are PUBLIC, safe for the browser) ──
# Same values as above URL, plus the "anon public" key (not the service role key)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ── Resend (sends the actual welcome + weekly newsletter emails) ──
RESEND_API_KEY="re_your_resend_api_key"
# Must be an address on a domain you've verified in Resend, e.g. "JarCheck <hello@yourdomain.com>"
EMAIL_FROM="JarCheck <hello@yourdomain.com>"

# ── Stripe (subscription billing, 15-day trial then $9.99/mo) ──
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PRICE_ID="price_your_recurring_price_id"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# ── Optional: protects /api/newsletter/sent-log and verifies Vercel Cron requests ──
ADMIN_KEY="choose-a-long-random-string"
CRON_SECRET="choose-a-different-long-random-string"
